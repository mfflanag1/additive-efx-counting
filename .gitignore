# Live solver workspaces and regenerable proof transcripts.  Durable theorem
# notes, generators, compact JSON summaries, formal sources, and verification
# code stay versioned; these multi-gigabyte files remain local.
/output/*
!/output/cap5-certification/
!/output/cap6-certification/
/output/cap5-certification/*
/output/cap6-certification/*
!/output/cap5-certification/efx49_distinct_half_full_cell_cap5_core17.drat.xz
